# Optional backup refresh. The website process already refreshes every 6 hours.
# Install only if you want systemd to poke localhost independently:
#   sudo cp deploy/vps/digeratiexperts-threat-refresh.service /etc/systemd/system/
#   sudo cp deploy/vps/digeratiexperts-threat-refresh.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now digeratiexperts-threat-refresh.timer

[Unit]
Description=Refresh Digerati public threat-intel cache
After=network.target digeratiexperts-site.service

[Service]
Type=oneshot
User=diger7051
Group=diger7051
ExecStart=/usr/bin/curl -fsS -X POST --max-time 120 http://127.0.0.1:3300/api/internal/threats/refresh
