RewriteEngine On

# Canonical redirect: digerati-experts.com -> digeratiexperts.com
RewriteCond %{HTTP_HOST} ^(www\.)?digerati-experts\.com$ [NC]
RewriteRule ^ https://digeratiexperts.com%{REQUEST_URI} [R=301,L]

# Do NOT rewrite API routes
RewriteRule ^api(/.*)?$ - [L]

# Serve existing files/folders normally
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback
RewriteRule ^ index.html [L]
